# Application Configuration
APP_NAME=JARVIS
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=dev-secret-key-must-be-changed-in-production-min-32-chars
TIMEZONE=Asia/Kolkata
PORT=8000
HOST=0.0.0.0

# Database Configuration
# In local development without PostgreSQL, leave blank or use sqlite+aiosqlite:///./jarvis_dev.db
DATABASE_URL=sqlite+aiosqlite:///./jarvis_dev.db

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Placeholders for future phases (Not used in Phase 1)
# NVIDIA_API_KEY=
# ELEVENLABS_API_KEY=
