# Application Configuration
APP_NAME=JARVIS
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=dev-secret-key-must-be-changed-in-production-min-32-chars
TIMEZONE=Asia/Kolkata
PORT=8000
HOST=0.0.0.0

# Database Configuration
# In local development without PostgreSQL, leave blank or use sqlite+aiosqlite:///./jarvis_dev.db
DATABASE_URL=sqlite+aiosqlite:///./jarvis_dev.db

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Real AI Inference & Voice API Keys (Optional - defaults to local offline engine if not set)
# 1. NVIDIA NIM (Llama 3.1 8B/70B) from https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...

# 2. Or Groq (Free, ultra-fast Llama 3.1/3.3) from https://console.groq.com
# GROQ_API_KEY=gsk_...

# 3. Or OpenAI (GPT-4o) from https://platform.openai.com
# OPENAI_API_KEY=sk-...

# Real Neural Voice Synthesis (Optional)
# ElevenLabs API Key from https://elevenlabs.io
# ELEVENLABS_API_KEY=
